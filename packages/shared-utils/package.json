{
  "name": "@dotabod/shared-utils",
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "module": "src/index.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./event-sub": {
      "types": "./dist/event-sub.d.ts",
      "import": "./dist/event-sub.js"
    }
  },
  "scripts": {
    "prebuild": "rm -rf dist",
    "build": "tsdown --config ../../tsdown.config.ts src/index.ts src/event-sub.ts -f esm -d dist --sourcemap",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.21.0",
    "@twurple/api": "7.2.1",
    "@twurple/auth": "7.2.1",
    "winston": "^3.17.0",
    "zod": "^4.5.4"
  }
}
